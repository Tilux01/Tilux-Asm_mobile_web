/* ==========================================================================
   TILUX MOBILE REMOTE - 1-TO-1 REACT NATIVE STYLESHEET MATCH
   ========================================================================== */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  -webkit-tap-highlight-color: transparent;
}

html, body {
  width: 100%;
  height: 100%;
  background-color: #0B0E14;
  color: #FFFFFF;
  overflow: hidden;
}

.hidden {
  display: none !important;
}

/* Root & Container */
.root, .container {
  width: 100%;
  height: 100vh;
  max-width: 480px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  background-color: #0B0E14;
  position: relative;
}

/* Header */
.header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 14px 16px;
  border-bottom: 1px solid #1E293B;
  background-color: #0B0E14;
}

.title {
  font-size: 18px;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 1px;
}

.title-accent {
  color: #00F2FE;
}

/* Badge */
.badge {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 5px 10px;
  border-radius: 20px;
  max-width: 180px;
}

.badge-on {
  background-color: rgba(16, 185, 129, 0.15);
  border: 1px solid rgba(16, 185, 129, 0.4);
}

.badge-off {
  background-color: rgba(239, 68, 68, 0.15);
  border: 1px solid rgba(239, 68, 68, 0.4);
}

.dot {
  width: 6px;
  height: 6px;
  border-radius: 3px;
  margin-right: 6px;
  display: inline-block;
}

.dot-on {
  background-color: #10B981;
}

.dot-off {
  background-color: #EF4444;
}

.badge-text {
  font-size: 12px;
  color: #E2E8F0;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Pair Scroll & Card */
.pair-scroll {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 20px;
  overflow-y: auto;
}

.card {
  background-color: #111827;
  border-radius: 20px;
  padding: 22px;
  border: 1px solid #1F2937;
}

.pair-title {
  font-size: 22px;
  font-weight: 700;
  color: #FFFFFF;
  text-align: center;
}

.pair-sub {
  font-size: 13px;
  color: #94A3B8;
  text-align: center;
  margin-top: 8px;
  margin-bottom: 20px;
  line-height: 1.4;
}

.scan-button {
  width: 100%;
  background-color: #00F2FE;
  border-radius: 14px;
  padding: 17px 0;
  border: none;
  color: #0B0E14;
  font-size: 15px;
  font-weight: 800;
  letter-spacing: 1px;
  cursor: pointer;
  text-align: center;
}

.web-hint {
  color: #F59E0B;
  font-size: 11px;
  text-align: center;
  margin-top: 10px;
  line-height: 1.4;
}

/* Divider */
.divider {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 20px 0;
}

.div-line {
  flex: 1;
  height: 1px;
  background-color: #1F2937;
}

.div-text {
  color: #475569;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1px;
  margin: 0 10px;
}

/* Form Inputs & Labels */
.label {
  display: block;
  color: #64748B;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1px;
  margin-bottom: 6px;
  margin-top: 4px;
}

.input {
  width: 100%;
  background-color: #0B0E14;
  border-radius: 12px;
  padding: 13px 14px;
  color: #FFFFFF;
  font-size: 14px;
  border: 1px solid #334155;
  margin-bottom: 12px;
  outline: none;
}

.input::placeholder {
  color: #64748B;
}

.connect-button {
  width: 100%;
  background-color: #0284C7;
  border-radius: 14px;
  padding: 16px 0;
  border: none;
  color: #FFFFFF;
  font-size: 15px;
  font-weight: 700;
  margin-top: 6px;
  cursor: pointer;
  text-align: center;
}

/* Chat Screen */
.chat {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.message-list {
  padding: 16px;
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
}

.empty-text {
  color: #475569;
  font-size: 13px;
  text-align: center;
  margin-top: 40px;
  line-height: 1.4;
}

.bubble {
  max-width: 82%;
  padding: 13px;
  border-radius: 16px;
  margin-bottom: 10px;
  word-break: break-word;
  font-size: 14px;
  line-height: 20px;
}

.user-bubble {
  align-self: flex-end;
  background-color: #0284C7;
  border-bottom-right-radius: 4px;
  color: #FFFFFF;
}

.ai-bubble {
  align-self: flex-start;
  background-color: #1E293B;
  border: 1px solid #334155;
  border-bottom-left-radius: 4px;
  color: #FFFFFF;
}

/* Loading Row */
.loading-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 8px 0;
}

.loading-text {
  color: #00F2FE;
  font-size: 12px;
  margin-left: 8px;
}

.spinner {
  width: 14px;
  height: 14px;
  border: 2px solid rgba(0, 242, 254, 0.2);
  border-top-color: #00F2FE;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* Input Dock */
.input-dock {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 10px 12px;
  border-top: 1px solid #1E293B;
  background-color: #0B0E14;
}

.chat-input {
  flex: 1;
  background-color: #1E293B;
  border-radius: 24px;
  padding: 12px 18px;
  color: #FFFFFF;
  font-size: 14px;
  margin-right: 10px;
  border: 1px solid #334155;
  outline: none;
}

.chat-input::placeholder {
  color: #64748B;
}

.send-button {
  width: 46px;
  height: 46px;
  border-radius: 23px;
  background-color: #00F2FE;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0B0E14;
  font-size: 18px;
  font-weight: bold;
  cursor: pointer;
}

.disconnect-row {
  display: flex;
  justify-content: center;
  align-items: center;
  padding-bottom: 8px;
}

.disconnect-text {
  background: none;
  border: none;
  color: #64748B;
  font-size: 12px;
  text-decoration: underline;
  cursor: pointer;
}

/* Scanner Container */
.scanner-container {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: #000000;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.absolute-fill {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.scan-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.scan-frame {
  width: 240px;
  height: 240px;
  border: 3px solid #00F2FE;
  border-radius: 16px;
}

.scan-hint {
  color: #FFFFFF;
  font-size: 14px;
  margin-top: 24px;
  font-weight: 600;
}

.cancel-button {
  margin-top: 40px;
  padding: 12px 32px;
  border-radius: 24px;
  background-color: rgba(255, 255, 255, 0.15);
  border: none;
  color: #FFFFFF;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
}
